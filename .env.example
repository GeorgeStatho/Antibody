# Copy to .env and fill in. .env is gitignored — keep it that way.

# --- GCP ---
PROJECT_ID=
REGION=us-central1

# --- Vertex AI ---
# ADK reads these two directly.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model ID for every agent in the fleet.
# Bare model ID, NOT a publishers/google/models/... resource path — ADK's
# Agent(model=...) wants the short form.
# Verified against Vertex in us-central1: gemini-2.5-flash responds;
# gemini-2.0-flash, gemini-3-flash and gemini-flash-latest all 404 there.
VERTEX_MODEL_ID=gemini-2.5-flash

# --- Pub/Sub topics ---
TOPIC_RAW_ARTICLES=raw-articles
TOPIC_SIGNALS=signals
TOPIC_INCIDENTS=incidents
# Triage -> Diagnosis handoff. Declared as `triage-verdict` in the registry.
TOPIC_VERDICTS=triage-verdicts
TOPIC_APPROVALS=approvals

# --- Firestore ---
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_POSITIONS=positions
FIRESTORE_COLLECTION_SIGNATURES=incident-signatures
# Triage's own idempotency ledger + MTTR t0 stamp. Not the Memory Bank.
FIRESTORE_COLLECTION_VERDICTS=triage-verdicts

# --- Model Armor ---
# TODO: fill in after creating the template (Phase 2, Day 8).
# DEV ONLY — lets Triage prompt on unscanned text while no template exists.
# Leave empty (false) on anything deployed. See agents/common/config.py.
ALLOW_UNSCANNED_PROMPT=

MODEL_ARMOR_TEMPLATE_ID=

# --- Approval gate ---
# URL of the approve/deny endpoint the Response agent links to.
APPROVAL_ENDPOINT_URL=
