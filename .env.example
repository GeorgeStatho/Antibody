# Copy to .env and fill in. .env is gitignored — keep it that way.

# --- GCP ---
PROJECT_ID=
REGION=us-central1

# --- Vertex AI ---
# ADK reads these two directly.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model ID for every agent in the fleet.
# TODO: verify the exact current Flash model ID before filling this in — the
# README previously said "Gemini 3.5 Flash", which is not a real model.
# Check: https://console.cloud.google.com/vertex-ai/model-garden
VERTEX_MODEL_ID=

# --- Pub/Sub topics ---
TOPIC_RAW_ARTICLES=raw-articles
TOPIC_SIGNALS=signals
TOPIC_INCIDENTS=incidents
TOPIC_APPROVALS=approvals

# --- Firestore ---
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_POSITIONS=positions
FIRESTORE_COLLECTION_SIGNATURES=incident-signatures

# --- Model Armor ---
# TODO: fill in after creating the template (Phase 2, Day 8).
MODEL_ARMOR_TEMPLATE_ID=

# --- Approval gate ---
# URL of the approve/deny endpoint the Response agent links to.
APPROVAL_ENDPOINT_URL=
